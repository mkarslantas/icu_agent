# ICU Agent Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# ANTHROPIC API CONFIGURATION
# ============================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# ============================================
# AGENT CONFIGURATION
# ============================================
# Default model to use (claude-sonnet-4-5-20250929, claude-opus-4, etc.)
DEFAULT_MODEL=claude-sonnet-4-5-20250929

# Maximum tokens for API calls
MAX_TOKENS=4096

# Temperature for Claude responses (0.0-1.0)
TEMPERATURE=0.0

# Maximum retries for failed API calls
MAX_RETRIES=3

# ============================================
# SYSTEM CONFIGURATION
# ============================================
# Enable parallel processing for batch operations
ENABLE_PARALLEL=true

# Maximum concurrent workers for parallel processing
MAX_WORKERS=5

# ============================================
# PATHS
# ============================================
# Base directory for state files
STATE_DIR=./state

# Base directory for patient data
PATIENTS_DIR=./patients

# Base directory for prompts
PROMPTS_DIR=./prompts

# Base directory for config files
CONFIG_DIR=./config

# Base directory for logs
LOGS_DIR=./logs

# ============================================
# LOGGING
# ============================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable file logging
LOG_TO_FILE=true

# Log file rotation (in MB)
LOG_MAX_SIZE=10

# Number of backup log files to keep
LOG_BACKUP_COUNT=5

# ============================================
# MONITORING & ALERTS
# ============================================
# Enable system notifications for critical alerts
ENABLE_NOTIFICATIONS=true

# Notification command (macOS: terminal-notifier, Linux: notify-send)
NOTIFICATION_CMD=terminal-notifier

# ============================================
# PERFORMANCE
# ============================================
# Cache prompt templates in memory
CACHE_PROMPTS=true

# Enable state caching for faster reloads
CACHE_STATE=true

# Cache TTL in seconds
CACHE_TTL=3600

# ============================================
# OPTIONAL: WEB DASHBOARD (Phase 7)
# ============================================
# FLASK_SECRET_KEY=your_secret_key_here
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5000
# FLASK_DEBUG=false
